  "keyFeatures": [
    "Animate CSS properties, SVG, DOM attributes and JavaScript objects",
    "Timeline-based animation sequencing with position control",
    "Comprehensive easing functions including spring physics and cubic-bezier",
    "Stagger effects for animating multiple elements with offsets",
    "Draggable interactions with snap and custom bounds",
    "Text splitting and character-level animations",
    "SVG path and morphing animations",
    "Scroll-triggered and event-driven animations",
    "Additive animation composition",
    "WAAPI integration support"
  ],
  "publicApiSurface": [
    "animate(targets, parameters)",
    "Timeline class",
    "Timer class",
    "Animatable class",
    "Draggable class",
